ter-spacing:.04em}\n  .compare tbody th{font-weight:600;color:var(--ink-2);white-space:nowrap}\n\n  .clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}\n  .clients .ticket h3{display:flex;justify-content:space-between;gap:10px;align-items:baseline}\n  .clients .ticket h3 em{font-style:normal;font-size:11px;letter-spacing:.14em;color:var(--ink-3)}\n  .clients p{font-size:14.5px;color:var(--ink-2);margin:0 0 8px}\n  .clients p:last-child{margin-bottom:0}\n\n  .faq-group{margin-bottom:34px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group > h3{font-size:12px;letter-spacing:.18em;color:var(--ink-3);font-weight:700;margin-bottom:14px}\n  .qa{display:flex;flex-direction:column;gap:12px}\n  .q{align-self:flex-start;max-width:88%;border:1px dashed var(--ink-3);padding:10px 14px;font-weight:600;font-size:15px;background:var(--wash)}\n  .a{align-self:flex-end;max-width:88%;border:1px dashed var(--line);padding:12px 14px;font-size:14.5px;color:var(--ink-2)}\n  .a p{margin:0 0 8px}\n  .a p:last-child{margin:0}\n\n  footer{padding:26px 0 44px;font-size:12.5px;color:var(--ink-3);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid var(--ink)}\n  footer .links a{margin-right:14px}\n  footer .links a:last-child{margin-right:0}\n\n  @media (min-width:760px){\n    .plans{grid-template-columns:1fr 1fr}\n    .plan.featured{grid-row:span 1}\n    .q{max-width:70%}\n    .a{max-width:70%}\n  }\n</style><div class=\"wrap\">\n\n  <header class=\"masthead\">\n    <span class=\"mark\">绒爪云</span>\n    <span class=\"jump\">\n      <a href=\"#plans\">套餐</a><a href=\"#how\">使用说明</a><a href=\"#clients\">客户端</a><a href=\"#faq\">常见问题</a>\n    </span>\n  </header>\n\n  <main>\n\n    <section class=\"hero\">\n      <h1>绒爪云<span class=\"dot\">。</span></h1>\n      <div class=\"hero-foot\">\n        <p class=\"lede\">三档订阅，价格、流量、设备数直接列在下面。看清单，再决定。不写长篇介绍，只放你需要核对的信息。</p>\n        <div class=\"label\">本月清单\n          <strong>3 档订阅 · 4 项客户端说明 · 8 条问答</strong>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01 / 套餐</span>\n        <h2>三档订阅，按月或按年</h2>\n      </div>\n\n      <div class=\"plans\">\n\n        <div class=\"ticket plan\">\n          <span class=\"tag\">基础版</span>\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <div class=\"price\">¥15 <span>/ 月</span></div>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n\n        <div class=\"ticket plan featured\">\n          <span class=\"badge\">推荐</span>\n          <span class=\"tag\">旗舰版</span>\n          <div class=\"plan-head\">\n            <h3>旗舰版</h3>\n            <div class=\"price\">¥35 <span>/ 月</span></div>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n\n        <div class=\"ticket plan\">\n          <span class=\"tag\">团队版</span>\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <div class=\"price\">¥85 <span>/ 月</span></div>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n\n        <div class=\"ticket note\">\n          <h3>选档请先核三件事</h3>\n          <p class=\"small muted\">一看设备数：家里几台手机、几台电脑，加总不超过档位上限。二看流量：按每月实际用量估，别按峰值估。三看用途：常规浏览选基础版，多设备与流媒体选旗舰版，多人共用选团队版。</p>\n        </div>\n\n      </div>\n\n      <table class=\"compare\">\n        关键条目横向核对\n        <thead>\n          <tr><th>条目</th><th>基础版</th><th>旗舰版</th><th>团队版</th></tr>\n        </thead>\n        <tbody>\n          <tr><th>月付价格</th><td>¥15 / 月</td><td>¥35 / 月</td><td>¥85 / 月</td></tr>\n          <tr><th>年付价格</th><td>¥150 / 年</td><td>¥350 / 年</td><td>¥850 / 年</td></tr>\n          <tr><th>每月流量</th><td>100GB</td><td>300GB</td><td>1000GB</td></tr>\n          <tr><th>同时在线设备</th><td>3 台</td><td>5 台</td><td>20 台</td></tr>\n          <tr><th>线路</th><td>普通线路节点池</td><td>含 IPLC 专线游戏加速优化</td><td>VIP 专属高带宽节点</td></tr>\n          <tr><th>额外条目</th><td>基础流媒体解锁</td><td>全节点原生流媒体解锁、7×24 优先工单</td><td>企业定制路由、专属客户经理</td></tr>\n        </tbody>\n      </table>\n    </section>\n\n    <section id=\"how\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02 / 使用说明</span>\n        <h2>从下单到接入的四步</h2>\n      </div>\n\n      <ol class=\"steps\">\n        <li class=\"ticket\">\n          <div class=\"step-no\">STEP 1</div>\n          <h3>选档</h3>\n          <p>对照上面的表，把设备台数和月流量写在纸上，再挑档。档位定错了，先改档，不要先接设备。</p>\n        </li>\n        <li class=\"ticket\">\n          <div class=\"step-no\">STEP 2</div>\n          <h3>拿到订阅信息</h3>\n          <p>订阅开通后你会得到一份订阅条目，含配置信息与各客户端的导入方式说明。请自行保存，不与他人共享。</p>\n        </li>\n        <li class=\"ticket\">\n          <div class=\"step-no\">STEP 3</div>\n          <h3>在客户端导入</h3>\n          <p>按设备类型选对应客户端，导入配置后先做一次连通性测试，确认可用再接第二台设备。</p>\n        </li>\n        <li class=\"ticket\">\n          <div class=\"step-no\">STEP 4</div>\n          <h3>按月核对用量</h3>\n          <p>月底看一次流量与在线设备数，超出就上调档位。长期用不上就下调，清单式管理，别放着不动。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03 / 客户端</span>\n        <h2>四类设备，四种接法</h2>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"ticket\">\n          <h3>桌面端 <em>电脑</em></h3>\n          <p>在电脑上安装对应客户端，导入订阅配置后由客户端统一管理节点切换。建议只开一个实例，避免重复连接。</p>\n          <p class=\"small muted\">下载地址与具体版本以你收到的订阅信息中列出的来源为准。</p>\n        </div>\n        <div class=\"ticket\">\n          <h3>移动端 <em>手机 / 平板</em></h3>\n          <p>移动端受系统限制较多，部分客户端需要手动添加配置。导入完成后，先在 Wi-Fi 与蜂窝数据下各测一次。</p>\n          <p class=\"small muted\">同一档位的在线设备数包含手机与平板，请一并计入。</p>\n        </div>\n        <div class=\"ticket\">\n          <h3>路由器 <em>整网接入</em></h3>\n          <p>路由器接入后，家中设备共享一路连接，省去逐台配置。开启前请确认路由器支持导入配置，并保留原有网络设置备查。</p>\n          <p class=\"small muted\">路由器本身算作一台在线设备。</p>\n        </div>\n        <div class=\"ticket\">\n          <h3>团队设备 <em>多人共用</em></h3>\n          <p>团队版支持企业定制路由与专属客户经理，多人接入前先约定各人的配置归属，避免同一份配置被重复分发。</p>\n          <p class=\"small muted\">团队版在线设备上限为 20 台。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04 / 常见问题</span>\n        <h2>八条问答，逐条作答</h2>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于套餐</h3>\n        <div class=\"qa\">\n          <div class=\"q\">三档套餐的核心差别是什么？</div>\n          <div class=\"a\">\n            <p>三项：每月流量额度、同时在线设备数、线路类型。价格差异主要来自这三项，其他条目都是附加。</p>\n          </div>\n\n          <div class=\"q\">年付比月付便宜多少？</div>\n          <div class=\"a\">\n            <p>基础版月付 ¥15、年付 ¥150；旗舰版月付 ¥35、年付 ¥350；团队版月付 ¥85、年付 ¥850。年付一次结清全年，不按月扣。</p>\n          </div>\n\n          <div class=\"q\">可以中途换档吗？</div>\n          <div class=\"a\">\n            <p>按你的实际用量决定即可。先看月底的流量与设备数记录，再决定往上还是往下调，避免长期付费买用不到的额度。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用</h3>\n        <div class=\"qa\">\n          <div class=\"q\">同时在线设备数怎么算？</div>\n          <div class=\"a\">\n            <p>按同一时间正在连接的设备台数计。基础版 3 台、旗舰版 5 台、团队版 20 台。路由器接入也占一个名额。</p>\n          </div>\n\n          <div class=\"q\">流量用完会怎样？</div>\n          <div class=\"a\">\n            <p>当月额度用尽后，当月的连接会受到影响。具体表现与恢复方式以订阅信息中的说明为准，建议在用量接近上限时提前决定是否换档。</p>\n          </div>\n\n          <div class=\"q\">在电脑上能用，换到手机就不通，先查什么？</div>\n          <div class=\"a\">\n            <p>先查三样：配置是否完整导入、该设备是否已算进在线名额、系统是否拦截了客户端的网络权限。三项都正常，再换一个节点试。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于账户与支持</h3>\n        <div class=\"qa\">\n          <div class=\"q\">订阅配置可以分享给朋友吗？</div>\n          <div class=\"a\">\n            <p>不建议。配置被多人使用会占用同一档位的在线名额，也容易互相干扰。多人共用请直接选团队版。</p>\n          </div>\n\n          <div class=\"q\">工单支持怎么用？</div>\n          <div class=\"a\">\n            <p>旗舰版提供 7×24 优先工单支持，团队版配有专属客户经理。提工单时写清设备类型、客户端名称、具体现象与已做过的排查，回复会更快。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer>\n    <span>绒爪云 · 清单式订阅说明</span>\n    <span class=\"links\">\n      <a href=\"#plans\">回到套餐</a>\n      <a href=\"#how\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </span>\n  </footer>\n\n</div>",
